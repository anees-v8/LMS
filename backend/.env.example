# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins (marketing site + app)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgres://campus:campus_dev_pw@localhost:5432/campus

# ─── JWT ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_64_char_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_64_char_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ─── Trial / Billing ──────────────────────────────────────
TRIAL_DAYS=7
BILLING_GRACE_DAYS=2
DEFAULT_PLAN_AMOUNT=2500

# ─── Razorpay (payments) ──────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# ─── Firebase (push notifications) ─────────────────────────
# From Firebase Console → Project Settings → Service Accounts →
# "Generate new private key" (downloads a JSON file with these 3 fields).
# Leave unset to disable push — in-app notifications still work either way.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value as-is (keep the \n escapes, quote the whole thing)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Demo-Booking Notifications (ALL FREE) ────────────────
# 1) EMAIL (primary). Use a free Gmail App Password OR Resend free tier SMTP.
#    Gmail: host=smtp.gmail.com port=587 user=you@gmail.com pass=<app password>
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password
NOTIFY_EMAIL_TO=you@gmail.com
NOTIFY_EMAIL_FROM=Campus <you@gmail.com>

# 2) TELEGRAM (instant phone push, 100% free forever).
#    Create a bot via @BotFather → get token. Get your chat id via @userinfobot.
NOTIFY_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# 3) IN-APP inbox is always on (leads saved to DB, shown in Super Admin panel).

# ─── Google OAuth (per-teacher Google Meet auto-generation) ───────────────
# A bare service account CANNOT create Meet-conferencing events without
# Google Workspace, so each teacher connects their own Google account.
# Google Cloud Console → enable "Google Calendar API" → APIs & Services →
# Credentials → Create Credentials → OAuth client ID → "Web application".
# Same client ID is used by the mobile app (as serverClientId) and here.
# Leave unset and "Schedule Live Class" fails with a clear error instead of
# silently falling back to the old manual-paste-a-link flow.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
